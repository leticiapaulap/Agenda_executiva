SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://agenda_user:example-password@localhost:5432/agenda_db
ADMIN_USERNAME=gestor
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$fake-salt$fake-password-hash
# ADMIN_* are used only for one-time import into an empty users table.
# After bootstrap, users and independent password hashes are managed in PostgreSQL.
AGENDA_MANAGER_NAME=Nome fictício do gestor
SESSION_COOKIE_SECURE=true
# Optional: absolute private persistent Render disk directory, outside static.
# RECEIPT_STORAGE_DIR=/var/data/agenda-receipts
# Vault defaults to directory-only. Generate keys privately; never commit them.
VAULT_ENABLED=false
VAULT_KEYS=
VAULT_ACTIVE_KEY_ID=
# Desktop only: Werkzeug hash of local vault authentication password.
# VAULT_DESKTOP_PASSWORD_HASH=
